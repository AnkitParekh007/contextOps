# PRIVATE PILOT TEMPLATE. Do not commit the filled .env.production.
DATABASE_URL="postgresql://USER:PASSWORD@PRIVATE_DB_HOST:5432/DB?schema=public"
REDIS_URL="redis://PRIVATE_REDIS_HOST:6379"
AUTH_SECRET="REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
APP_URL="https://your-secure-pilot.example"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Required for hosted pilot registration; keep private and rotate if exposed.
# The app fails closed in production if missing or less than 20 characters.
PILOT_INVITE_CODE="REPLACE_WITH_A_SEPARATE_RANDOM_INVITATION_SECRET"

# Phase 11: hosted invitation-only identity flows fail closed without a real, verified sender.
RESEND_API_KEY=""
EMAIL_FROM="ContextOps AI <security@your-verified-domain.example>"
# 32 bytes in hexadecimal; keep separate from AUTH_SECRET and rotate through a planned MFA migration.
MFA_ENCRYPTION_KEY="REPLACE_WITH_64_RANDOM_HEX_CHARACTERS"

# Phase 12: disabled unless independent legal/security and budget gates are approved.
# Enabling this permits explicitly consented, frozen, authorized-sanitized
# model comparisons subject to the existing per-run max 10 requests.
ENABLE_EXTERNAL_BENCHMARKS=false

# When ENABLE_EXTERNAL_BENCHMARKS=true, ALSO require exact approved workspace IDs
# and an organization-wide daily conservative reservation cap (default $1/day).
BENCHMARK_APPROVED_WORKSPACE_IDS=""
BENCHMARK_DAILY_ORG_BUDGET_USD=1

# Phase 13: private status probe. Required for hosted pilot acceptance.
# Use a different securely generated random token than any other secret.
OPS_MONITOR_TOKEN="REPLACE_WITH_A_DIFFERENT_RANDOM_32_PLUS_CHARACTER_TOKEN"
# Degrade operational status when oldest pending import exceeds this age.
OPS_QUEUE_WARN_SECONDS=300

# Phase 18: 40-hex commit identity pinned to the exact deployment candidate.
CONTEXTOPS_RELEASE_SHA="REPLACE_WITH_EXACT_40_HEX_GIT_COMMIT_SHA"
