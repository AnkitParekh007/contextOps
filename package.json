{
  "name": "contextops-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "worker": "tsx scripts/worker.ts",
    "smoke:pilot": "node scripts/pilot-smoke.mjs",
    "smoke:operations": "node scripts/phase17-staging-acceptance.mjs",
    "preflight:hosted": "node scripts/phase18-deployment-preflight.mjs",
    "test:preflight": "node --test scripts/phase18-deployment-preflight.test.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "smoke:acceptance": "node scripts/phase14-acceptance.mjs",
    "verify:acceptance": "node scripts/verify-phase14-evidence.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "5.90.20",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^5.4.2",
    "jose": "^6.0.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.30.0",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.0",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
