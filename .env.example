# Copy to .env and replace AUTH_SECRET with a random 32+ character string.
DATABASE_URL="postgresql://contextops:contextops_local@localhost:5432/contextops?schema=public"
REDIS_URL="redis://localhost:6379"
AUTH_SECRET="REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET"
APP_URL="http://localhost:3000"
# Optional: set BOTH values, then npm run db:seed to create a demo account.
DEMO_EMAIL=""
DEMO_PASSWORD=""
